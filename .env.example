# MD Jibon Live Market Scanner - Environment Variables

# App Configuration
REACT_APP_NAME=MD Jibon Live Market Scanner
REACT_APP_VERSION=1.0.0
REACT_APP_ENV=development

# API Configuration
REACT_APP_API_URL=https://api.quotex.io
REACT_APP_API_KEY=your_api_key_here
REACT_APP_API_SECRET=your_api_secret_here

# Feature Flags
REACT_APP_ENABLE_AUTO_TRADE=false
REACT_APP_ENABLE_DEMO_MODE=true
REACT_APP_ENABLE_NOTIFICATIONS=true

# Detection Settings
REACT_APP_DETECTION_THRESHOLD=0.96
REACT_APP_CHART_MONITORING_INTERVAL=2000

# Trading Settings
REACT_APP_USE_LIVE_BALANCE=true
REACT_APP_MIN_TRADE_AMOUNT=1
REACT_APP_MAX_CONFIDENCE=0.95
REACT_APP_MIN_CONFIDENCE=0.42

# Logging
REACT_APP_LOG_LEVEL=info
REACT_APP_ENABLE_DEBUG=false

# Analytics
REACT_APP_ANALYTICS_ENABLED=false
REACT_APP_ANALYTICS_KEY=

# Monitoring
REACT_APP_ERROR_REPORTING=true
REACT_APP_CRASH_REPORTING=false
